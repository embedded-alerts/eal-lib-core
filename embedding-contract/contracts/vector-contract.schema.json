{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embedded-alerts.example/contracts/vector-contract.schema.json",
  "title": "Embedded Alerts vector storage contract",
  "type": "object",
  "required": ["exact", "indexed"],
  "properties": {
    "exact": {
      "type": "object",
      "required": ["original_dimensions", "embedding"],
      "properties": {
        "original_dimensions": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "embedding": {
          "type": "array",
          "minItems": 4100,
          "maxItems": 4100,
          "items": { "type": "number" }
        }
      },
      "additionalProperties": false
    },
    "indexed": {
      "type": "object",
      "required": ["indexed_embedding"],
      "properties": {
        "indexed_embedding": {
          "type": "array",
          "minItems": 4000,
          "maxItems": 4000,
          "items": { "type": "number" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
